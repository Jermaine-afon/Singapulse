# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEEPSEEK_API_KEY: Required for the AI Planner tab (server-side only, never sent to the browser).
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: Optional. Defaults to "deepseek-flash".
# DEEPSEEK_MODEL="deepseek-flash"

# ONEMAP_TOKEN: Enables real routes in "Getting there" (server-side only).
# Get a token from your OneMap account; it expires after 3 days.
ONEMAP_TOKEN="MY_ONEMAP_TOKEN"

# ONEMAP_EMAIL / ONEMAP_PASSWORD: Optional. If set, the server renews the
# OneMap token automatically so routing never stops when it expires.
# ONEMAP_EMAIL="you@example.com"
# ONEMAP_PASSWORD="your-onemap-password"
