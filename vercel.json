{
  "functions": {
    "api/plan.ts": {
      "maxDuration": 60
    },
    "api/route.ts": {
      "maxDuration": 30
    },
    "api/live.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
