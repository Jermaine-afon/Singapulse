  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lime pill-rectangle for the one primary action per view.",
      "html": "<button class=\"ds-btn-primary\">Plan my day <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 24px;border-radius:24px;border:none;font:600 16px/24px Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,transform 160ms ease;background:var(--color-primary,#9fe870);color:var(--color-ink-deep,#163300);} .ds-btn-primary:hover{background:var(--color-primary-active,#cdffad);} .ds-btn-primary:active{transform:scale(0.98);} .ds-btn-primary:focus-visible{outline:2px solid var(--color-ink,#0e0f0c);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Sage fill for supporting actions such as My Trail and refresh.",
      "html": "<button class=\"ds-btn-secondary\">My Trail <span class=\"ds-count\">2</span></button>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 24px;border-radius:24px;border:none;font:600 16px/24px Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,transform 160ms ease;background:var(--color-canvas-soft,#e8ebe6);color:var(--color-ink,#0e0f0c);} .ds-btn-secondary:hover{background:var(--color-canvas-line,#d3d8d0);} .ds-btn-secondary:active{transform:scale(0.98);} .ds-btn-secondary:focus-visible{outline:2px solid var(--color-ink,#0e0f0c);outline-offset:2px;} .ds-count{min-width:24px;border-radius:9999px;background:#fff;padding:0 6px;font-size:12px;line-height:20px;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Tertiary Button",
      "kind": "button",
      "refersTo": "button-tertiary",
      "description": "White with a 1px ink stroke; Details-style actions.",
      "html": "<button class=\"ds-btn-tertiary\">Place details</button>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-btn-tertiary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 24px;border-radius:24px;border:none;font:600 16px/24px Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,transform 160ms ease;background:var(--color-canvas,#fff);color:var(--color-ink,#0e0f0c);box-shadow:inset 0 0 0 1px var(--color-ink,#0e0f0c);} .ds-btn-tertiary:hover{background:var(--color-canvas-soft,#e8ebe6);} .ds-btn-tertiary:active{transform:scale(0.98);} .ds-btn-tertiary:focus-visible{outline:2px solid var(--color-ink,#0e0f0c);outline-offset:2px;}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Ink fill for strong non-primary actions such as Getting there.",
      "html": "<button class=\"ds-btn-dark\">Getting there</button>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-btn-dark{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 24px;border-radius:24px;border:none;font:600 16px/24px Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,transform 160ms ease;background:var(--color-ink,#0e0f0c);color:#fff;} .ds-btn-dark:hover{background:#2a2c27;} .ds-btn-dark:active{transform:scale(0.98);} .ds-btn-dark:focus-visible{outline:2px solid var(--color-ink,#0e0f0c);outline-offset:2px;}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "48px field, 12px radius, 1px ink border, lime focus ring, label above.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Starting from</span><input class=\"ds-input\" placeholder=\"e.g. Marina Bay Sands\"></label>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-field{display:block;max-width:360px;} .ds-field-label{display:block;font-size:14px;line-height:20px;font-weight:600;color:var(--color-ink,#0e0f0c);margin-bottom:6px;} .ds-input{width:100%;min-height:48px;padding:12px 16px;border-radius:12px;border:1px solid var(--color-ink,#0e0f0c);background:#fff;color:var(--color-ink,#0e0f0c);font:400 16px/24px Inter,ui-sans-serif,system-ui,sans-serif;transition:box-shadow 160ms ease;} .ds-input::placeholder{color:var(--color-mute,#6b6d6a);} .ds-input:focus{outline:none;box-shadow:0 0 0 3px var(--color-primary,#9fe870);}"
    },
    {
      "name": "Navigation Tabs",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "Pill tabs in the sticky white header; lime marks the current tab.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-wordmark\">Singapulse<i></i></span><a class=\"ds-tab\" aria-current=\"page\" href=\"#\">Plan my day</a><a class=\"ds-tab\" href=\"#\">Discover</a><a class=\"ds-tab\" href=\"#\">Weather</a><a class=\"ds-tab\" href=\"#\">Map</a></nav>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-nav{display:flex;align-items:center;gap:4px;height:64px;padding:0 16px;background:#fff;border-bottom:1px solid var(--color-canvas-line,#d3d8d0);} .ds-wordmark{font-weight:900;font-size:24px;letter-spacing:-0.03em;color:var(--color-ink,#0e0f0c);margin-right:24px;display:flex;align-items:center;gap:6px;} .ds-wordmark i{width:8px;height:8px;border-radius:9999px;background:var(--color-primary,#9fe870);} .ds-tab{padding:8px 16px;border-radius:9999px;font-size:15px;font-weight:600;color:var(--color-body,#454745);text-decoration:none;transition:background-color 160ms ease,color 160ms ease;} .ds-tab:hover{color:var(--color-ink,#0e0f0c);background:var(--color-canvas-soft,#e8ebe6);} .ds-tab[aria-current=page]{background:var(--color-primary,#9fe870);color:var(--color-ink-deep,#163300);} .ds-tab:focus-visible{outline:2px solid var(--color-ink,#0e0f0c);outline-offset:2px;}"
    },
    {
      "name": "Choice Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill toggle for interests and chat quick-replies; pressed fills ink.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Heritage &amp; history</button><button class=\"ds-chip\" aria-pressed=\"false\">Local food</button></div>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-chips{display:flex;gap:8px;flex-wrap:wrap;} .ds-chip{display:inline-flex;align-items:center;min-height:36px;padding:6px 14px;border-radius:9999px;border:none;font:600 14px/20px Inter,ui-sans-serif,system-ui,sans-serif;color:var(--color-ink,#0e0f0c);background:#fff;box-shadow:inset 0 0 0 1px var(--color-canvas-line,#d3d8d0);cursor:pointer;transition:background-color 160ms ease,box-shadow 160ms ease;} .ds-chip:hover{box-shadow:inset 0 0 0 1px var(--color-ink,#0e0f0c);} .ds-chip[aria-pressed=true]{background:var(--color-ink,#0e0f0c);color:#fff;box-shadow:none;} .ds-chip:focus-visible{outline:2px solid var(--color-ink,#0e0f0c);outline-offset:2px;}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-positive",
      "description": "Semantic status pills for data mode and weather risk.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge ds-pos\">Live</span><span class=\"ds-badge ds-warn\">Model estimate</span><span class=\"ds-badge ds-neu\">Partly covered</span></div>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-badges{display:flex;gap:8px;} .ds-badge{display:inline-flex;align-items:center;padding:4px 12px;border-radius:9999px;font:600 14px/20px Inter,ui-sans-serif,system-ui,sans-serif;white-space:nowrap;} .ds-pos{background:var(--color-primary-pale,#e2f6d5);color:var(--color-positive-deep,#054d28);} .ds-warn{background:var(--color-warning-pale,#fff3c4);color:var(--color-warning-content,#4a3b1c);} .ds-neu{background:var(--color-canvas-soft,#e8ebe6);color:var(--color-ink,#0e0f0c);}"
    },
    {
      "name": "Card on Sage",
      "kind": "card",
      "refersTo": "card",
      "description": "Borderless white 24px card that separates from the sage band by colour alone.",
      "html": "<div class=\"ds-band\"><div class=\"ds-card\"><h3>Fort Canning Tree Tunnel</h3><p>Soft morning light and no queue before the heat builds.</p></div></div>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-band{background:var(--color-canvas-soft,#e8ebe6);padding:32px;} .ds-card{background:#fff;border-radius:24px;padding:24px;max-width:360px;} .ds-card h3{margin:0;font-size:18px;font-weight:600;color:var(--color-ink,#0e0f0c);} .ds-card p{margin:6px 0 0;font-size:15px;line-height:1.6;color:var(--color-body,#454745);}"
    },
    {
      "name": "Timeline Stop",
      "kind": "custom",
      "refersTo": "card-soft",
      "description": "Signature plan row: tabular 900 time, ink node with lime icon on a sage spine, sage panel content; rises in with a 60ms stagger.",
      "html": "<div class=\"ds-stop\"><div class=\"ds-time\"><b>09:00</b><small>09:45</small></div><div class=\"ds-node\"><span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg></span><i></i></div><div class=\"ds-panel\"><h4>Fort Canning Tree Tunnel</h4><p>Museum &amp; Bras Basah</p></div></div>",
      "css": ":host{--color-primary:#9fe870;--color-primary-active:#cdffad;--color-primary-pale:#e2f6d5;--color-canvas:#fff;--color-canvas-soft:#e8ebe6;--color-canvas-line:#d3d8d0;--color-ink:#0e0f0c;--color-ink-deep:#163300;--color-body:#454745;--color-mute:#6b6d6a;--color-positive-deep:#054d28;--color-warning-pale:#fff3c4;--color-warning-content:#4a3b1c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;} .ds-stop{display:grid;grid-template-columns:80px 52px minmax(0,1fr);max-width:560px;animation:ds-rise 420ms cubic-bezier(0.16,1,0.3,1) both;} .ds-time{padding:16px 12px 0 0;text-align:right;font-variant-numeric:tabular-nums;} .ds-time b{display:block;font-size:20px;font-weight:900;letter-spacing:-0.025em;color:var(--color-ink,#0e0f0c);} .ds-time small{display:block;font-size:12px;color:var(--color-mute,#6b6d6a);} .ds-node{display:flex;flex-direction:column;align-items:center;} .ds-node span{margin-top:12px;width:36px;height:36px;border-radius:9999px;background:var(--color-ink,#0e0f0c);color:var(--color-primary,#9fe870);display:flex;align-items:center;justify-content:center;} .ds-node i{width:1px;flex:1;min-height:24px;background:var(--color-canvas-line,#d3d8d0);margin:4px 0;} .ds-panel{background:var(--color-canvas-soft,#e8ebe6);border-radius:24px;padding:20px;margin-bottom:24px;} .ds-panel h4{margin:0;font-size:18px;font-weight:600;color:var(--color-ink,#0e0f0c);} .ds-panel p{margin:6px 0 0;font-size:14px;color:var(--color-body,#454745);} @keyframes ds-rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}} @media (prefers-reduced-motion:reduce){.ds-stop{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Calm Ledger",
    "overview": "Singapulse is a planning tool before it is a travel brochure. The world is a sage-and-white ledger: soft sage bands carry the page, white cards sit inside them without borders, and near-black olive ink does all the talking. One lime accent marks the thing to do next, and nothing else. The day-planner card is the hero object, the way a calculator widget is the hero of a finance product; the headline beside it is set in very heavy Inter so the page has a voice without needing photography.\n\nDensity is moderate and deliberate. Forms are generous (48px controls), times and readings are tabular, and depth comes from surface contrast (white on sage, sage on white) rather than shadow. Motion is short and exponential: content rises into place, overlays fade, and reduced-motion users see everything at once.\n\nThe system explicitly refuses the travel-template arrangement: no full-bleed photo hero, no eyebrow labels over every block, no cards strewn with chips. Photography appears only inside landmark cards and modals, inset in a rounded frame.",
    "keyCharacteristics": [
      "Sage (#e8ebe6) bands alternate with white sections; white cards on sage, sage panels on white.",
      "One lime accent for primary actions, the active nav tab, selection and the wordmark dot.",
      "Inter only: 900 for display voice, 600 for titles and labels, 400 for body.",
      "Pill buttons and chips, 24px cards, 12px inputs with a 1px ink border.",
      "Flat by default; shadows only for floating things (dropdowns, map controls, map labels).",
      "Tabular numerals for every time, duration and reading."
    ],
    "rules": [
      {
        "name": "The One Lime Rule",
        "body": "Lime marks the next action or the current selection, and appears on at most one or two elements per viewport. There is no second brand accent.",
        "section": "colors"
      },
      {
        "name": "The Ink On Lime Rule",
        "body": "Anything on lime is set in Deep Forest Ink. Never white text on lime, never lime on green.",
        "section": "colors"
      },
      {
        "name": "The Semantic-Only Colour Rule",
        "body": "Yellow, red and green appear only to report weather risk, data status, errors or map categories, never as decoration.",
        "section": "colors"
      },
      {
        "name": "The Nine Hundred Rule",
        "body": "Hero and plan headlines are Inter 900. Never lighten the display weight; hierarchy below it comes from size, then 600.",
        "section": "typography"
      },
      {
        "name": "The Tabular Times Rule",
        "body": "Every time, date, duration, temperature and count uses tabular numerals so columns of times align.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels and buttons are sentence case at normal tracking. No uppercase micro-labels.",
        "section": "typography"
      },
      {
        "name": "The Surface Contrast Rule",
        "body": "Cards never get a border or shadow to separate them from the page; they separate by colour. A card on sage is white; a card on white is sage.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put white cards on sage bands and sage panels on white sections; separate by surface, not stroke.",
      "**Do** keep Signal Lime to the primary action, the active tab, selection and the wordmark dot, with Deep Forest Ink text on it.",
      "**Do** set hero and plan headlines in Inter 900 at -0.03em and 0.92 line-height.",
      "**Do** use 48px pill-rectangle buttons (24px radius) and 12px-radius inputs with a 1px ink border and a 3px lime focus ring.",
      "**Do** set every time, duration and reading in tabular numerals.",
      "**Do** label estimates and simulations honestly with badges (warning for model estimate, neutral for forecast estimate, positive for live).",
      "**Do** keep shadows soft olive-ink ambients, used only for floating elements over content or the map."
    ],
    "donts": [
      "**Don't** add a second brand accent, or use semantic yellow, red or green decoratively.",
      "**Don't** put lime on lime or green backgrounds, or white text on lime.",
      "**Don't** set the hero display lighter than 900 or swap in a second display face.",
      "**Don't** use sharp-cornered buttons or square chips.",
      "**Don't** add borders or drop shadows to resting cards.",
      "**Don't** add uppercase eyebrow labels above headings, or a full-bleed photo hero.",
      "**Don't** use Stone Mute for anything but secondary information; body copy is Graphite Body or Olive Ink."
    ]
  }
}
